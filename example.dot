graph G {

    ratio = fill
    size = "10,8"
    nodesep = 0.8           //horizontal spacing
    ranksep = 1.2           // vertical spacing

    node [
        shape=circle
        style=filled
        fillcolor=lightblue
        fontsize=40
        penwidth=4
    ]

    edge [
        fontsize=50
        penwidth = 4
    ]

    0 -- 1 [label="2"]
    0 -- 2 [label="4"]
    1 -- 2 [label="1"]
    1 -- 3 [label="7"]
    2 -- 4 [label="3"]
    3 -- 5 [label="1"]
    4 -- 3 [label="2"]
    4 -- 5 [label="5"]
}

// dot -Tpng example.dot -o example.png - for .png file
// dot -Tsvg example.dot -o example.svg - for .svg file