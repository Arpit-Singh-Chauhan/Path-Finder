graph G {

    ratio = fill
    size = "10,8"
    nodesep = 0.8           //horizontal spacing
    ranksep = 1.2           // vertical spacing
    pad = "1.0"

    node [
        shape=circle
        style=filled
        fillcolor=lightblue
        fontsize=40
        penwidth=4
    ]

    edge [
        fontsize=50
        penwidth = 4
    ]

    A -- B [label="2"];
    A -- C [label="4"];
    B [fillcolor=green];
    B -- C [label="1", color=orange, penwidth=5];
    B -- D [label="7"];
    C [fillcolor=lightyellow];
    C -- E [label="3", color=orange, penwidth=5];
    D [fillcolor=lightyellow];
    D -- F [label="1", color=orange, penwidth=5];
    D -- E [label="2", color=orange, penwidth=5];
    E [fillcolor=lightyellow];
    E -- F [label="5"];
    F [fillcolor=red];
}

// source [B] to destination [F] => Path - B -> C -> E -> D -> F
// source - red [B]
// destination - green [F]
// path => nodes - light yellow
//         edges - yellow


// dot -Tpng example.dot -o example.png - for .png file
// dot -Tsvg example.dot -o example.svg - for .svg file